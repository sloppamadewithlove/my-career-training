if(NOT INPUT OR NOT OUTPUT)
  message(FATAL_ERROR "pin_dll_sha.cmake requires INPUT and OUTPUT")
endif()
if(NOT EXISTS "${INPUT}")
  message(FATAL_ERROR "file-view DLL is missing: ${INPUT}")
endif()
file(SHA256 "${INPUT}" MCT_DLL_SHA256)
string(TOLOWER "${MCT_DLL_SHA256}" MCT_DLL_SHA256)
string(LENGTH "${MCT_DLL_SHA256}" MCT_DLL_SHA256_LENGTH)
if(NOT MCT_DLL_SHA256_LENGTH EQUAL 64)
  message(FATAL_ERROR "file-view DLL SHA-256 was not 64 hex characters")
endif()
get_filename_component(MCT_PIN_DIR "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${MCT_PIN_DIR}")
file(WRITE "${OUTPUT}"
"#pragma once\n// Generated from the linked MctNativeFileView64.dll. Do not edit.\ninline constexpr char kMctPinnedFileViewDllSha256[] = \"${MCT_DLL_SHA256}\";\n")
